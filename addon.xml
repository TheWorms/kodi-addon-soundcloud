<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.audio.soundcloud" name="SoundCloud" version="6.0.7" provider-name="TheWorms">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.29.0"/>
        <!-- Pillow (PIL fork) is used to generate the blurred cover art
             background and extract the dominant colour for the
             "Now Playing" fullscreen overlay (waveform / cinema styles).
             Marked optional="true" so the addon still loads and works
             on Kodi installs where script.module.pil is missing
             (notably some Android builds) — the overlays gracefully
             fall back to unblurred covers in that case. -->
        <import addon="script.module.pil" version="1.0.0" optional="true"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>audio</provides>
    </extension>
    <extension point="xbmc.python.script" library="script.py">
        <provides>audio</provides>
    </extension>
    <!--
        Background service: runs from Kodi login to Kodi shutdown.
        Its only role is to keep a splash window ready to display the
        moment plugin.py asks for it via the "soundcloud.splash"
        Window property. Without this, the user would see the music
        browser for ~500ms after click before our splash appears.
        Can be disabled via the "service.preload" setting on
        low-memory devices.
    -->
    <extension point="xbmc.service" library="service.py" start="login">
        <provides>audio</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="de_DE">SoundCloud – Musik- und Podcast-Streaming-Plattform</summary>
        <summary lang="en_GB">SoundCloud – Music and podcast streaming platform</summary>
        <summary lang="fr_FR">SoundCloud – Plateforme de streaming musical et de podcasts</summary>
        <summary lang="nl_NL">SoundCloud – Muziek- en podcaststreamingplatform</summary>
        <description lang="de_DE">SoundCloud ist eine Musik- und Podcast-Streaming-Plattform, mit der Du Millionen von Songs aus der ganzen Welt anhören kannst.</description>
		<description lang="en_GB">SoundCloud is a music and podcast streaming platform that lets you listen to millions of songs from around the world.</description>
        <description lang="fr_FR">SoundCloud est une plateforme de streaming musical et de podcasts qui vous permet d'écouter des millions de titres du monde entier.</description>
        <description lang="nl_NL">SoundCloud is een muziek- en podcaststreamingplatform waarmee je naar miljoenen nummers van over de hele wereld kunt luisteren.</description>
        <disclaimer lang="en_GB">This plugin is not official, approved or endorsed by SoundCloud.</disclaimer>
        <disclaimer lang="fr_FR">Ce plugin n'est pas officiel, approuvé ou soutenu par SoundCloud.</disclaimer>
        <disclaimer lang="nl_NL">Deze plugin is niet officieel, goedgekeurd of gesteund door SoundCloud.</disclaimer>
        <platform>all</platform>
        <license>MIT</license>
        <forum>https://forum.kodi.tv/showthread.php?tid=206635</forum>
        <website>https://soundcloud.com</website>
        <source>https://github.com/TheWorms/kodi-addon-soundcloud</source>
        <credits>jaylinski (original add-on), bromix, SLiX</credits>
        <news>6.0.7 (2026-11-12) - the full-screen UI opens on top of the splash, with nothing showing in between, and closing it goes straight back to the home screen without passing through the file browser. Full history in changelog.txt.</news>
        <assets>
            <icon>resources/icon-addon.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
